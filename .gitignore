# Environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Data: ERA5 downloads and derived feature tables (re-create with scripts/download_era5_timeseries.py
# and scripts/build_features.py). Licensed CC-BY-4.0 by ECMWF / Copernicus C3S, but large.
data/
*.part
*.nc

# Trained models and bulky intermediate outputs (re-create with scripts/run_era5_only.sh)
models/
results/phase4_sensitivity/*/
results/*/*/predictions.parquet
results/logs/

# Build by-products (regenerated by report/src/build.py and presentation/src/build_deck.py)
report/src/eq/
presentation/previews/
~$*
